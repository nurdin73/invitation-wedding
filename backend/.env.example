# Application Environment
NODE_ENV=development
PORT=4000
APP_NAME=plannikah
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_random_salt_at_least_64_characters_long_for_security_compliance
ARGON2_PEPPER=local_development_pepper_string

# PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5433/wedding_saas

# Object Storage (MinIO Local / Cloudflare R2)
R2_ACCOUNT_ID=local-minio
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadminpassword
R2_BUCKET_NAME=wedding-invitations-media
R2_PUBLIC_DOMAIN=http://localhost:9000/wedding-invitations-media
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-development_mock_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-development_mock_key
MIDTRANS_IS_PRODUCTION=false

# SMTP Transactional Mailer (Mailpit Local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@undangan.local
